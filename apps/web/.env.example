# Convex deployment URL (dashboard > Settings > URL and Deploy Keys)
NEXT_PUBLIC_CONVEX_URL=
# Convex HTTP actions URL (same value ending in .site)
NEXT_PUBLIC_CONVEX_SITE_URL=

# Optional canonical site URL used for metadata/sitemap links.
# NEXT_PUBLIC_SITE_URL=http://localhost:3004

# Billing provider: "polar" (default) or "dodo". One variable switches the
# checkout, customer portal and product catalog for this app.
# BILLING_PROVIDER=polar

# Polar (required when BILLING_PROVIDER=polar)
# POLAR_ACCESS_TOKEN=
# POLAR_SERVER=sandbox
# POLAR_ORGANIZATION_ID=
# POLAR_WEBHOOK_SECRET=

# Dodo Payments (required when BILLING_PROVIDER=dodo)
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
