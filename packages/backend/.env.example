# Set Convex environment variables
# npx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
# npx convex env set SITE_URL http://localhost:3004
# npx convex env set AI_GATEWAY_API_KEY your_vercel_ai_gateway_key

# Auth
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
# Apple only: generated with `node scripts/generate-apple-secret.mjs`
APPLE_CLIENT_SECRET=

# Cloudflare Email Sending (OTP sign-in, email verification, password reset)
# 1. Onboard your domain: Cloudflare dashboard > Email > Email Sending.
# 2. Create an API token: My Profile > API Tokens > Create Token.
#    Scope: Account > Email Sending > Edit (or Account > Email Service > Edit).
# 3. AUTH_EMAIL_FROM must use the onboarded domain, e.g.
#    AUTH_EMAIL_FROM="Convex Starter <noreply@yourdomain.com>"
# npx convex env set CLOUDFLARE_ACCOUNT_ID your_account_id
# npx convex env set CLOUDFLARE_EMAIL_API_TOKEN your_api_token
# npx convex env set AUTH_EMAIL_FROM "Convex Starter <noreply@yourdomain.com>"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM=Convex Starter <noreply@yourdomain.com>
# Optional display name used in email copy (defaults to Convex Starter)
AUTH_EMAIL_APP_NAME=Convex Starter

# Vercel AI Gateway (for English Tutor Agent)
# Get your API key from https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Convex
# Same as CONVEX_URL but ends in .site (used by Better Auth clients)
EXPO_PUBLIC_CONVEX_SITE_URL=
# Same as CONVEX_URL but ends in .site (used by Better Auth clients)
NEXT_PUBLIC_CONVEX_SITE_URL=
# Public web origin. Must be one of the Better Auth trusted origins.
# SITE_URL=http://localhost:3004

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT= # team: abhishekrajemail-gmail-com, project: quotes-f3864
CONVEX_URL=
# Deep link scheme used by the Expo app, e.g. convexstarter://
NATIVE_APP_URL=convexstarter://

# Polar cloud env
# npx convex env set POLAR_ORGANIZATION_TOKEN your_token
# npx convex env set POLAR_WEBHOOK_SECRET your_webhook_secret
# npx convex env set POLAR_PRODUCT_PRO_MONTHLY product_id_from_polar
# npx convex env set POLAR_PRODUCT_PRO_YEARLY product_id_from_polar

# Polar
POLAR_ORGANIZATION_TOKEN=
POLAR_WEBHOOK_SECRET=

# RevenueCat HTTP webhook Authorization header value
# npx convex env set REVENUECAT_WEBHOOK_SECRET your_authorization_header_value
REVENUECAT_WEBHOOK_SECRET=

# Optional: allow RevenueCat webhooks without a secret ONLY when this is set.
# Any other value (including unset) fails closed in production.
# CONVEX_ENV=development

# Cloudflare R2 storage
# 1. Create an R2 bucket: Cloudflare dashboard > R2 > Create bucket.
# 2. Create an R2 API token (Object Read & Write) and note the access key,
#    secret, and S3 endpoint (https://<account_id>.r2.cloudflarestorage.com).
# 3. R2_TOKEN is the Cloudflare API token used for account-level management.
# 4. Configure CORS on the bucket for your web/admin origins and PUT/GET:
#    AllowedHeaders: content-type, AllowedMethods: GET, PUT, HEAD.
# 5. Set the variables for the Convex deployment:
# npx convex env set R2_BUCKET your-bucket-name
# npx convex env set R2_ENDPOINT https://<account_id>.r2.cloudflarestorage.com
# npx convex env set R2_ACCESS_KEY_ID your_access_key_id
# npx convex env set R2_SECRET_ACCESS_KEY your_secret_access_key
# npx convex env set R2_TOKEN your_cloudflare_api_token
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
