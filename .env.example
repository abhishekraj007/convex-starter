# Polar Configuration (Better-Auth Integration)
# Get these from https://polar.sh/dashboard

# Polar Access Token (required)
# Create from: Organization Settings > Access Tokens
POLAR_ACCESS_TOKEN=polar_at_xxxxx

# Polar Server Environment
# Use "sandbox" for testing, "production" for live
POLAR_SERVER=sandbox

# Polar Webhook Secret (required for webhooks)
# Get from: Organization Settings > Webhooks
POLAR_WEBHOOK_SECRET=polar_wh_xxxxx


# Site Configuration
SITE_URL=http://localhost:3004
NATIVE_APP_URL=convexstarter://

# Better-Auth Configuration
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx

# Cloudflare Email Sending (OTP + password reset emails)
# Onboard a domain under Email > Email Sending, then create an API token with
# Account > Email Sending > Edit. Set these on the Convex deployment:
# npx convex env set CLOUDFLARE_ACCOUNT_ID your_account_id
# npx convex env set CLOUDFLARE_EMAIL_API_TOKEN your_api_token
# npx convex env set AUTH_EMAIL_FROM "Convex Starter <noreply@yourdomain.com>"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMAIL_API_TOKEN=
AUTH_EMAIL_FROM="Convex Starter <noreply@yourdomain.com>"

# Cloudflare R2 storage (uploads demo)
# npx convex env set R2_BUCKET your-bucket-name
# npx convex env set R2_ENDPOINT https://<account_id>.r2.cloudflarestorage.com
# npx convex env set R2_ACCESS_KEY_ID your_access_key_id
# npx convex env set R2_SECRET_ACCESS_KEY your_secret_access_key
# npx convex env set R2_TOKEN your_cloudflare_api_token
R2_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
